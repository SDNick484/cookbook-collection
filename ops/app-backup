#!/bin/sh
# Nightly backup of the family apps on this server (installed by setup-cookbooks.sh).
# - Consistent SQLite snapshots (sqlite3 .backup) of Cookbooks, Dinner Log and the wish list,
#   kept for $KEEP_DAYS days in $LOCAL_DIR (small: databases only).
# - If BACKUP_TARGET is set (e.g. an NFS/SMB mount from a NAS), the snapshots *and* the photo/cover
#   folders are copied there too, so a lost container disk loses nothing.
# - If BACKUP_TARGET is empty and photo/cover files exist, they are NOT backed up: that is logged as a warning
#   every night, and app-notify is told once when the state begins (and once when it ends).
#
#   app-backup                run the backup
#   app-backup --check-images print the warning and exit 0 if image files aren't backed up; print nothing and
#                             exit 1 if they are covered (or there are none). The installer's summary uses this.
#
# Config: /etc/conf.d/app-ops     Log: /var/log/app-ops.log
# LIB_DIR, LOCAL_DIR, STATE_DIR, LOG, NOTIFY and OPS_CONF can be set in the environment (the tests do).
set -u
OPS_CONF=${OPS_CONF:-/etc/conf.d/app-ops}
[ -f "$OPS_CONF" ] && . "$OPS_CONF"
LIB_DIR=${LIB_DIR:-/var/lib}
LOCAL_DIR=${LOCAL_DIR:-/var/backups/apps}
STATE_DIR=${STATE_DIR:-$LIB_DIR/app-ops}
NOTIFY=${NOTIFY:-/usr/local/bin/app-notify}
KEEP_DAYS=${KEEP_DAYS:-14}
BACKUP_TARGET=${BACKUP_TARGET:-}
APPS="cookbooks dinner-log wishlist"
STAMP=$(date +%Y-%m-%d)
LOG=${LOG:-/var/log/app-ops.log}
LABEL=${HOST_LABEL:-$(hostname)}
log() { echo "$(date '+%F %T') backup: $*" >> "$LOG"; }

# Succeeds, printing a one-line warning, when there are image files and nowhere to copy them.
unprotected_images() {
  [ -z "$BACKUP_TARGET" ] || return 1
  total=0 where=""
  for app in $APPS; do
    for sub in covers photos uploads; do
      [ -d "$LIB_DIR/$app/$sub" ] || continue
      n=$(find "$LIB_DIR/$app/$sub" -type f 2>/dev/null | wc -l | tr -d ' ')
      [ "${n:-0}" -gt 0 ] || continue
      total=$((total + n)); where="${where:+$where, }$LIB_DIR/$app/$sub ($n)"
    done
  done
  [ "$total" -gt 0 ] || return 1
  echo "image files are not backed up: $total in $where. Only the databases are snapshotted. Set BACKUP_TARGET in $OPS_CONF to a folder on other storage to copy them too."
}

if [ "${1:-}" = "--check-images" ]; then
  unprotected_images
  exit $?
fi

fail=0
mkdir -p "$LOCAL_DIR/$STAMP"
for app in $APPS; do
  dir=$LIB_DIR/$app
  [ -d "$dir" ] || continue
  for db in "$dir"/*.db; do
    [ -f "$db" ] || continue
    out="$LOCAL_DIR/$STAMP/$app-$(basename "$db")"
    if sqlite3 -cmd ".timeout 30000" "$db" ".backup '$out'" && [ "$(sqlite3 "$out" 'PRAGMA integrity_check;')" = "ok" ]; then
      gzip -f "$out"
      log "ok $app/$(basename "$db") ($(du -h "$out.gz" | cut -f1))"
    else
      rm -f "$out"
      log "FAILED $app/$(basename "$db")"; fail=1
    fi
  done
done

# retention
find "$LOCAL_DIR" -mindepth 1 -maxdepth 1 -type d -mtime +"$KEEP_DAYS" -exec rm -rf {} + 2>/dev/null

if [ -n "$BACKUP_TARGET" ]; then
  if [ -d "$BACKUP_TARGET" ] && [ -w "$BACKUP_TARGET" ]; then
    mkdir -p "$BACKUP_TARGET/db" && cp -a "$LOCAL_DIR/$STAMP" "$BACKUP_TARGET/db/" || fail=1
    for app in $APPS; do
      for sub in covers photos uploads files; do
        [ -d "$LIB_DIR/$app/$sub" ] || continue
        mkdir -p "$BACKUP_TARGET/files/$app/$sub"
        # photos/covers are write-once: copy new files only
        cp -au "$LIB_DIR/$app/$sub/." "$BACKUP_TARGET/files/$app/$sub/" || fail=1
      done
    done
    find "$BACKUP_TARGET/db" -mindepth 1 -maxdepth 1 -type d -mtime +"$KEEP_DAYS" -exec rm -rf {} + 2>/dev/null
    log "copied to $BACKUP_TARGET"
  else
    log "FAILED: BACKUP_TARGET $BACKUP_TARGET is not a writable directory (is it mounted?)"; fail=1
  fi
fi

# Image coverage. The warning is logged every night; the alert goes out once, when the state begins, and the
# state file keeps the nightly runs quiet. When the state ends (BACKUP_TARGET set, or the images are gone) a
# matching "up" is sent and the file removed, so a later relapse alerts again. The alert uses its own name so it
# doesn't mix with a "Backups" failure alert.
FLAG="$STATE_DIR/backup-images-unprotected"
if msg=$(unprotected_images); then
  log "WARNING: $msg"
  if [ ! -f "$FLAG" ]; then
    [ -x "$NOTIFY" ] && "$NOTIFY" "Backup coverage" down "On $LABEL, $msg"
    mkdir -p "$STATE_DIR" && : > "$FLAG"
  fi
elif [ -f "$FLAG" ]; then
  rm -f "$FLAG"
  log "image files are covered by backups again"
  [ -x "$NOTIFY" ] && "$NOTIFY" "Backup coverage" up "Image files on $LABEL are covered by backups again."
fi

if [ "$fail" != 0 ] && [ -x "$NOTIFY" ]; then
  "$NOTIFY" "Backups" down "Last night's backup on $LABEL had a problem. See $LOG."
fi
exit $fail
