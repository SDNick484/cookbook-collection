# Cookbook Collection settings, with placeholders. On a server the installer writes these to
# /etc/conf.d/cookbooks (and generates the tokens). For a local run:
#   cp .env.example .env && vim .env && set -a && . ./.env && set +a && python3 app.py
# .env is in .gitignore: never commit real values.

PORT=8767
DATA_DIR=./data

# Cloudflare Access in front of /admin
CF_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_AUD=
ADMIN_EMAILS=
# Editing straight from the LAN, without Cloudflare (0 = off)
LAN_EDIT=0
LAN_CIDRS=
LAN_HOSTS=
ALLOWED_ORIGINS=

# Dinner Log
DINNERLOG_API_URL=http://127.0.0.1:8000
DINNERLOG_TOKEN=
DINNERLOG_URL=https://dinner.example.com
READ_TOKEN=

# House recipes
HOUSE_BOOK_TITLE="House Recipes"
# Where the recipe editor may send you back to after a save (scheme://host[:port], comma separated)
RETURN_URL_ORIGINS=https://dinner.example.com

# Claude API: index photos and AI search (Ask)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=low
PHOTO_DAILY_LIMIT=100
ANTHROPIC_SEARCH_KEY=
ANTHROPIC_SEARCH_MODEL=claude-haiku-5-5
ASK_DAILY_LIMIT=200

# MCP
# MCP_TOKEN: one secret, or several comma separated while rotating (add new, move clients, remove old)
MCP_TOKEN=
MCP_PUBLIC=1
# 1 = write tools (set_want_to_try, update_book) for a token sent as Authorization: Bearer
MCP_WRITE=0
# 1 = also accept /mcp/<MCP_TOKEN> (always read-only); 0 = header only
MCP_URL_TOKEN=1

# Family wish list (optional)
WISHLIST_URL=http://127.0.0.1:8766
WISHLIST_BOOK_URL="https://www.amazon.com/s?k={q}"
